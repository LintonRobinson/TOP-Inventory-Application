<% if(items.length> 0) { %>
    <% items.forEach(function(item) { %>
        <div class="item">
            <a href="/category/<%=item.category%>/item/view/<%=item.id%>">
                <img src="/assets/view.png" alt="">
            </a>
            <span>
                <%=item.name%>
            </span>
            <span>
                $<%=item.price%>
            </span>
            <span class="url">
                <%=item.url%>
            </span>
            <span>
                <%=item.category_name%>
            </span>
            <span>
                <%=item.quantity%>
            </span>
            <a href="/category/<%=item.category%>/item/edit/<%=item.id%>">
                <img src="/assets/edit.png" alt="">
            </a>
        </div>
        <% }) %>
            <% } else { %>
                <% if(categories.length> 0) { %>
                    <div class="no-items">
                        <h1>No items found!</h1>
                        <a href="/category/<%=categoryId%>/item/new">Add your first item!</a>
                    </div>
                    <% } else { %>
                        <div class="no-items">
                            <h1>No items found!</h1>
                            <a href="/category/new">Create a category</a>
                        </div>
                        <% } %>
                            <% } %>
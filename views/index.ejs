<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shiraz Farm Inventory</title>
    <link rel="stylesheet" href="/styles/index.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Google Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
        rel="stylesheet">
    <link rel="icon" type="image/png" href="/assets/shiraz-logo.png">
</head>

<body>
    <header>
        <nav>
            <div class="nav-left">
                <img src="/assets/shiraz-logo.png" alt="Shiraz Farm Logo">
                <h1>Shiraz Farm Inventory</h1>
            </div>
            <div class="nav-right">
                <%if(categories.length> 0) {%>
                    <% if(title==="All Items" ) { %>
                        <form method="GET" action="/category/view">
                            <select onchange="this.form.submit()" name="categoryToView" id="categoryToView">
                                <option value="">
                                    All Items
                                </option>
                                <% categories.forEach((category)=> { %>
                                    <option value="<%=category.id%>">
                                        <%=category.name%>
                                    </option>
                                    <%}) %>
                            </select>
                        </form>
                        <% } else { %>
                            <form method="GET" action="/category/view">
                                <select onchange="this.form.submit()" name="categoryToView" id="categoryToView">
                                    <% categories.forEach((category)=> { %>
                                        <option value="<%=category.id%>" <%=category.id==categoryId ? 'selected' : '' %>
                                            >
                                            <%=category.name%>
                                        </option>
                                        <%}) %>
                                </select>
                            </form>
                            <% }; %>


                                <%};%>


                                    <form method="GET" action="/item/search" class="search-form">
                                        <button type="submit"></button>
                                        <input type="text" placeholder="Search For Item" name="text">
                                    </form>


            </div>
        </nav>
    </header>
    <main>
        <section class="category-heading">
            <div class="category-heading-text">
                <div>
                    <h2>
                        <%=title%>
                    </h2>
                    <div>
                        <% if(title !=="All Items" && title !=="Search Result" ) { %>
                            <a href="/category/edit/<%=categoryId%>">
                                <span>Edit Category</span>
                                <img src="/assets/pencil.png" alt="">
                            </a>
                            <a href="/">View All Items</a>
                            <% }; %>
                                <% if(title==="Search Result" ) { %>
                                    <a href="/">View All Items</a>
                                    <% }; %>
                    </div>
                </div>
                <p>
                    <%=description%>
                </p>

            </div>
            <div class="category-heading-buttons">
                <%if(categories.length> 0) {%>
                    <a href="/category/<%=categoryId%>/item/new">Create New Item</a>
                    <%};%>

                        <a href="/category/new">Create New Category</a>
            </div>
        </section>
        <section class="category-items">

            <div class="item-detail-headings">
                <span>Name</span>
                <span>Price</span>
                <span>URL</span>
                <span>Category</span>
                <span>Quantity</span>
            </div>
            <%- include("partials/categoryItems") %>

        </section>
    </main>
</body>

</html>
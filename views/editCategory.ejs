<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Category</title>
    <link rel="stylesheet" href="/styles/create-category.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Google Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap"
        rel="stylesheet">
    <link rel="icon" type="image/png" href="/assets/shiraz-logo.png">

</head>

<body>
    <main>
        <div class="form-heading-wrapper">
            <a href="/" class="back-button">
                <img src="/assets/back.png" alt="Back Arrow Icon">
                <span>Go Back</span>
            </a>
            <h1>Edit Category</h1>



        </div>
        <form action="" method="POST">
            <div class="form-field">
                <label for="categoryName">Name:</label>
                <input type="text" id="categoryName" name="categoryName" placeholder="Category Name"
                    value="<%=category.name%>" required>
            </div>
            <div class="form-field">
                <label for="categoryDescription">Description:</label>
                <textarea type="text" id="categoryDescription" name="categoryDescription"
                    placeholder="Category Description"><%=category.description%></textarea>
            </div>
            <div class="form-button-wrapper">
                <button class="submit-button" type="submit">Edit Category</button>
            </div>
        </form>
        <%- include("partials/errors") %>
    </main>
</body>

</html>